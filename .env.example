# ==============================================================================
# MemOptima — Variáveis de Ambiente de Exemplo (.env.example)
# Copie este arquivo para .env para customizar o comportamento local.
# NUNCA envie senhas reais ou credenciais de produção para o repositório.
# ==============================================================================

# Ambiente de Execução (development | production | test)
APP_ENV=development

# Modo de Operação (desktop | web_simulator)
MEMOPTIMA_MODE=desktop

# Limite de RAM em GB para disparo do Auto-Modo (padrão: 4.0)
MEMOPTIMA_LIMIT_GB=4.0

# Intervalo padrão em segundos entre verificações de pressão de RAM (padrão: 60)
MEMOPTIMA_INTERVAL_SEC=60

# Ativar ou desativar o Auto-Modo adaptativo no arranque (true | false)
MEMOPTIMA_AUTO_MODE=true

# Ativar otimização do cache de arquivos do sistema de arquivos / standby (true | false)
MEMOPTIMA_USE_FILECACHE=true

# Trava de segurança de Swap / Pagefile em GB (padrão: 4.0)
MEMOPTIMA_SWAP_LOCK_GB=4.0

# Iniciar minimizado na bandeja do sistema (System Tray) (true | false)
MEMOPTIMA_START_MINIMIZED=false

# Iniciar com o Windows (true | false)
MEMOPTIMA_START_WITH_WINDOWS=false

# ==============================================================================
# Configurações de Banco de Dados / Persistência (SQLite / PostgreSQL / MySQL)
# ==============================================================================
DB_CONNECTION=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=memoptima.db
DB_USER=memoptima_user
DB_PASS=senha_de_teste_123
